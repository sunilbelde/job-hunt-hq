<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Filled in and installed to /Library/LaunchDaemons by scripts/install_service.sh. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.job-hunt-hq</string>
    <key>UserName</key>
    <string>__USER__</string>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/.venv/bin/python</string>
        <string>-m</string>
        <string>app.serve</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>__PORT__</string>
        <!-- The docs listener. install_service.sh drops these two lines when DOCS_PORT=off. -->
        <string>--docs-port</string>
        <string>__DOCS_PORT__</string>
        <string>--log-config</string>
        <string>__REPO__/deploy/logging.json</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>TECTONIC_CACHE_DIR</key>
        <string>__HOME__/Library/Caches/job-hunt-hq/tectonic</string>
        <!-- The Claude Code CLI the install script found (often ~/.local/bin, outside PATH above). -->
        <key>CLAUDE_BIN</key>
        <string>__CLAUDE_BIN__</string>
        <!-- Wins over .env. app.serve also forces docs off on the public port, which Funnel
             publishes; only the docs port serves them. -->
        <key>API_DOCS_ENABLED</key>
        <string>false</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/job-hunt-hq/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/job-hunt-hq/launchd.log</string>
</dict>
</plist>
