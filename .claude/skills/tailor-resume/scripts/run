#!/bin/sh
# Runs resume_tool.py with the service's interpreter (TAILOR_PYTHON, set by app/tailoring.py) or, when
# run by hand in the repo, with the repo's .venv four levels up. Never python3 from PATH, which a
# shell profile could change.
exec "${TAILOR_PYTHON:-$(dirname "$0")/../../../../.venv/bin/python}" "$(dirname "$0")/resume_tool.py" "$@"
