# Copy to .env, then `chmod 600 .env`. Never commit real values.

# Required. Generate with: openssl rand -hex 32
API_KEY=change-me

# Optional. Where resumes (<OUTPUT_DIR>/<company>/<application id>/SUNIL BELDE.pdf) and the
# application store are kept (default shown). Keep it out of ~/Documents, ~/Desktop and
# ~/Downloads, which macOS blocks for background services.
OUTPUT_DIR=~/Library/Application Support/job-hunt-hq

# Resume tailoring runs Claude Code. Set one credential; with neither, resumes that need scoring fail.
# Subscription token (uses your Claude plan): run `claude setup-token` and paste the token as one line.
CLAUDE_CODE_OAUTH_TOKEN=
# Or an API key from the Claude Console, billed per run. When both are set, the API key is used.
ANTHROPIC_API_KEY=

# Optional tailoring settings (defaults shown). The time limit and the estimated spend cap cover all the
# Claude runs for one resume together (analysis, judge, tailoring); reaching either fails the request.
TAILORING_MODEL=claude-opus-5-5
TAILORING_TIMEOUT_SECONDS=420
TAILORING_MAX_BUDGET_USD=3
# The Claude Code CLI. The installed service gets the path the install script found.
CLAUDE_BIN=claude

# Optional, default false. Serves the API reference at /docs (with Try it out), /redoc and
# /openapi.json. Local development only: the installed service always runs with it off.
API_DOCS_ENABLED=false
