# Copy to .env, then `chmod 600 .env`. Never commit real values.

# Required. Generate each with: openssl rand -hex 32
API_KEY=change-me
# At least 32 characters. Changing it invalidates every outstanding download link.
LINK_SIGNING_SECRET=change-me-to-at-least-32-characters
# Base of the download links handed out by POST /jobs: this Mac's Tailscale HTTPS name.
PUBLIC_BASE_URL=https://mac-mini.your-tailnet.ts.net

# Optional. Where generated files are stored (default shown). Keep it out of
# ~/Documents, ~/Desktop and ~/Downloads, which macOS blocks for background services.
OUTPUT_DIR=~/Library/Application Support/job-hunt-hq
# Files older than this are deleted. Must cover SIGNED_URL_TTL_SECONDS.
OUTPUT_RETENTION_DAYS=30
# Download link lifetime. Max 604800 (7 days).
SIGNED_URL_TTL_SECONDS=604800

# Optional for now; used by a later change
ANTHROPIC_API_KEY=
